HOST=0.0.0.0
PORT=8090
DEBUG=false
TIMEZONE_NAME = Europe/Moscow

# STT
STT_MODEL=small
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8

# Classifier
CLASSIFIER_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CLASSIFIER_THRESHOLD=0.55
CLASSIFIER_MARGIN=0.05

# TTS
TTS_ENGINE=silero # silero/qwen_mlx/qwen_torch
TTS_VOICE_DIR=tts/voices/marusya

SERVER_URL = http://localhost:8082